# ── secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python / uv ─────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints/
analysis/notebooks/*.ipynb       # rendered; regenerate via render_notebooks.sh

# ── editors / OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── bulk data: re-fetchable from public sources ─────────────
data_raw/aidev/
data_raw/github_cache/

# ── derived data: keep manifests + small JSONs, ignore bulk ─
data_derived/**/*.parquet
data_derived/**/*.parquet.crc

# Keep run_manifest.json and other small JSONs (allow-list overrides above):
!data_derived/**/*.json

# Allow-list the canonical run's parquets (committed via Git-LFS):
!data_derived/2026-04-25/*.parquet

# ── per-session scratch ─────────────────────────────────────
tasks/

# ── runtime logs ────────────────────────────────────────────
logs/

# ── git-lfs cache (don't commit pointers' blob content) ─────
.git-lfs/

# ── local tooling scaffolding (not part of study artifacts) ─
.claude/
.mcp.json
CLAUDE.md
SETUP.md
analysis/THREATS_TO_VALIDITY.md